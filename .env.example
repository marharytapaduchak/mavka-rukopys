
# MAVKA — RUKOPYS
# Copy this file to .env when environment variables are needed.
# Never commit .env files containing real credentials.

# Optional Hugging Face access token.
# Public dataset metadata can be downloaded without authentication.
# A token may be required for gated models or higher rate limits.
HF_TOKEN=

# Optional Hugging Face repository for published model checkpoints.
HF_MODEL_REPO=

# Optional Kaggle credentials for competition submissions.
# Do not commit real credentials.
KAGGLE_USERNAME=
KAGGLE_KEY=
